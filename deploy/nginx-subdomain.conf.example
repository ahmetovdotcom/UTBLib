# OPTIONAL template for an existing HOST nginx. Do not replace its main config.
# DNS and certificates for this NEW name must already exist.
server {
    listen 443 ssl;
    server_name catalog.kaztbu.edu.kz;
    ssl_certificate /etc/letsencrypt/live/catalog.kaztbu.edu.kz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/catalog.kaztbu.edu.kz/privkey.pem;
    client_max_body_size 10m;
    location / {
        proxy_pass http://127.0.0.1:8097;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
    }
}
