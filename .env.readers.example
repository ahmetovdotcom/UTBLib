# Optional integrations; separate from staff login and catalogue settings.
LIBRARY_TIMEZONE=Asia/Almaty
LIBRARY_NAME=Библиотека КазУТБ
READER_TICKET_PREFIX=KazTBU
READER_FACULTY_CODES={}
READER_SYNC_MIN_RATIO=0.8
PLATONUS_ENABLED=false
PLATONUS_DB_HOST=platonus-readers-tunnel
PLATONUS_DB_PORT=6080
PLATONUS_DB_NAME=
PLATONUS_DB_USER=
PLATONUS_DB_PASSWORD=
PLATONUS_QUERY_TIMEOUT_SECONDS=5
PLATONUS_CHUNK=500
PLATONUS_DB_SSL_CA=
PLATONUS_ACADEMIC_YEAR=
PLATONUS_STUDENT_STATUS_COLUMN=
PLATONUS_INACTIVE_STUDENT_STATUSES=[]
PLATONUS_TUTOR_STATUS_COLUMN=
PLATONUS_INACTIVE_TUTOR_STATUSES=[]
PLATONUS_STATUS_MAPPING_CONFIRMED=false
PLATONUS_GENDER_MAP={"1":"female","2":"male"}
PLATONUS_DEGREE_MAP={"1":"bachelor","2":"master","3":"master","6":"doctoral","8":"specialist"}
AD_ENABLED=false
AD_HOST=
AD_PORT=636
AD_USE_SSL=true
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_BASE_DN=
AD_USER_FILTER=(&(objectCategory=person)(objectClass=user))
AD_FILTER_CONFIRMED=false
AD_REQUIRE_CERT=true
AD_CA_CERT_PATH=
AD_ATTRIBUTE_MAP={}
AD_PLATONUS_TYPE_MAP={"1":"student","2":"tutor"}
AD_PLATONUS_LINK_CONFIRMED=true
AD_LEAVER_STATUSES=[]
AD_STATUS_MAPPING_CONFIRMED=false
AD_DEFAULT_CATEGORY=staff
AD_CATEGORY_MAP={}
# SSH values are read by Compose --env-file, not inferred from any existing system.
PLATONUS_SSH_HOST=
PLATONUS_SSH_USER=
PLATONUS_REMOTE_MYSQL_HOST=
PLATONUS_SSH_KEY_PATH=
PLATONUS_KNOWN_HOSTS_PATH=

# Ночной запуск в Asia/Almaty. Требуется сервис readers-scheduler.
READERS_NIGHTLY_ENABLED=true
READERS_NIGHTLY_TIME=03:20
# Порт MySQL на удалённой стороне SSH-туннеля (для старого прокси: 6080).
PLATONUS_REMOTE_MYSQL_PORT=3306
# CA положить в deploy/readers/certs, AD_CA_CERT_PATH=/reader-certs/ad-ca.crt
