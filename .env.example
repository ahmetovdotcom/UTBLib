POSTGRES_PASSWORD=change_to_random_alphanumeric_password
ADMIN_KEY=change_to_long_random_admin_key

# Used only to initialize the first administrator; never resets existing passwords.
ADMIN_INITIAL_PASSWORD=change_to_long_admin_password
# Set true only with HTTPS.
COOKIE_SECURE=false

# Optional: book description from photos. Server-side only.
OPENAI_API_KEY=
OPENAI_CATALOG_MODEL=gpt-5.6-terra
